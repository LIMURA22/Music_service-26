<div id="like_button_<%= post.id %>" class="like-wrapper">
  <% if user_signed_in? %>
    <% if post.likes.exists?(user: current_user) %>
      <%= button_to post_like_path(post, post.likes.find_by(user: current_user)),
                    method: :delete,
                    class: "like-btn liked",
                    form: { data: { turbo_frame: "like_button_#{post.id}" } } do %>
        <svg viewBox="0 0 24 24" class="heart" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      <% end %>
    <% else %>
      <%= button_to post_likes_path(post),
                    method: :post,
                    class: "like-btn",
                    form: { data: { turbo_frame: "like_button_#{post.id}" } } do %>
        <svg viewBox="0 0 24 24" class="heart" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      <% end %>
    <% end %>
  <% else %>
    <%= link_to new_user_session_path,
                class: "like-btn",
                data: { turbo: false } do %>
      <svg viewBox="0 0 24 24" class="heart" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
      </svg>
    <% end %>
  <% end %>
  <span class="like-count"><%= post.likes.count %></span>
</div>