<!DOCTYPE html>
<html>
  <head>
    <title>Melotoria</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="main-header">
      <div class="container header-container">
        <!-- Логотип -->
        <h1 class="logo"><%= link_to "Melotoria", root_path %></h1>

        <!-- Навигация -->
        <nav class="main-nav">
          <% if user_signed_in? %>
            <div class="nav-links">
              <%= link_to "Меню", categories_path, class: "nav-link" rescue link_to("Меню", "#", class: "nav-link") %>
              <%= link_to "Все посты", posts_path, class: "nav-link" %>
              <%= link_to "Коллаборации", collab_boards_path, class: "nav-link" %>
              <%= link_to "О проекте", about_path, class: "nav-link" %>
            </div>

            <div class="nav-actions">
              <%= link_to "Предложить пост", new_post_path, class: "btn-new" %>

              <details class="profile-dropdown">
                <summary class="profile-summary">
                  <% if current_user.avatar.present? %>
                    <%= image_tag current_user.avatar.url, class: "nav-avatar" %>
                  <% else %>
                    <div class="nav-avatar-placeholder"><%= current_user.display_name.first.upcase %></div>
                  <% end %>
                  <span class="nav-username"><%= current_user.display_name %></span>
                  <span class="dropdown-arrow">▼</span>
                </summary>
                
                <div class="dropdown-content">
                  <div class="dropdown-header">
                    <strong><%= current_user.display_name %></strong><br>
                    <small><%= current_user.email %></small>
                  </div>
                  <hr>
                  <% if current_user.admin? %>
                    <%= link_to "Модерация постов", admin_posts_path, class: "dropdown-item" %>
                    <%= link_to "Модерация комментариев", admin_comments_path, class: "dropdown-item" %>
                  <% else %>
                    <%= link_to "Мои посты", my_posts_path, class: "dropdown-item" %>
                  <% end %>
                  <%= link_to "Уведомления", "#", class: "dropdown-item" %>
                  <%= link_to "Настройки профиля", edit_user_registration_path, class: "dropdown-item" %>
                  <hr>
                  <%= link_to "Выйти", destroy_user_session_path, data: { turbo_method: :delete }, class: "dropdown-item text-danger" %>
                </div>
              </details>
            </div>

          <% else %>
            <div class="nav-links">
              <%= link_to "Промо", root_path, class: "nav-link" %>
              <%= link_to "О проекте", about_path, class: "nav-link" %>
            </div>
            
            <div class="nav-actions">
              <%= link_to "Войти", new_user_session_path, class: "btn-login" %>
            </div>
          <% end %>
        </nav>
      </div>
    </header>

    <main class="<%= current_page?(root_path) ? 'promo-wrapper' : 'container main-content' %>">
      <% if notice %>
        <p class="notice"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>

    <footer class="main-footer">
      <div class="bottom-green-line"></div>
      <div class="container">
        <p>© 2026 Melotoria — медиасервис для музыкантов</p>
      </div>
    </footer>
  </body>
</html>