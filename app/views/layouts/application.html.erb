<!DOCTYPE html>
<html>
  <head>
    <title>Melotoria</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="main-header">
      <div class="container">
        <h1 class="logo"><%= link_to "Melotoria", root_path %></h1>
        <nav class="main-nav">
         <%= link_to "Все посты", posts_path %>
         <%= link_to "О проекте", "#" %>
          <% if user_signed_in? %>
            <% if current_user.admin? %>
              <%= link_to "Модерация", admin_posts_path %>
              <%= link_to "Комментарии", admin_comments_path %>
            <% else %>
              <%= link_to "Мои посты", my_posts_path %>
            <% end %>
            <%= link_to "Предложить пост", new_post_path, class: "btn-new" %>
            <span style="display: flex; align-items: center; gap: 8px; color: #999; font-size: 14px;">
              <% if current_user.avatar.present? %>
                <%= image_tag current_user.avatar.url, style: "width: 32px; height: 32px; border-radius: 50%; object-fit: cover;" %>
              <% end %>
             Привет, <%= current_user.display_name %>
           </span>
            <%= link_to "Выйти", destroy_user_session_path, data: { turbo_method: :delete } %>
         <% else %>
           <%= link_to "Войти", new_user_session_path %>
           <%= link_to "Регистрация", new_user_registration_path %>
         <% end %>
        </nav>
      </div>
    </header>

    <main class="container">
      <% if notice %>
        <p class="notice"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>

    <footer class="main-footer">
      <div class="container">
        <p>© 2026 Melotoria — медиасервис для музыкантов</p>
      </div>
    </footer>
  </body>
</html>