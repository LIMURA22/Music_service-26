<div id="<%= dom_id collab_board %>">
  <div>
    <strong>Title:</strong>
    <%= collab_board.title %>
  </div>

  <div>
    <strong>Description:</strong>
    <%= collab_board.description %>
  </div>

  <div>
    <strong>Looking for:</strong>
    <%= collab_board.looking_for %>
  </div>

  <div>
    <strong>City:</strong>
    <%= collab_board.city %>
  </div>

  <div>
    <strong>Genre:</strong>
    <%= collab_board.genre %>
  </div>

  <div>
    <strong>User:</strong>
    <%= collab_board.user_id %>
  </div>

</div>
