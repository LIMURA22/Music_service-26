<h2>Редактировать профиль</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <p><%= f.label :email, "Email" %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <div class="field">
    <p><%= f.label :name, "Имя или ник" %></p>
    <p><%= f.text_field :name %></p>
  </div>

  <div class="field">
    <p><%= f.label :avatar, "Аватарка" %></p>
    <% if resource.avatar.present? %>
      <p><%= image_tag resource.avatar.url, style: "width: 80px; height: 80px; border-radius: 50%; object-fit: cover;" %></p>
    <% end %>
    <p><%= f.file_field :avatar %></p>
  </div>


  <div class="field" style="margin: 20px 0; padding: 15px; background: #f9f9f9; border-radius: 8px;">
    <%= f.check_box :is_searchable %>
    <%= f.label :is_searchable, "Показывать мой профиль в поиске музыкантов (отключите для приватности)", class: "text-black" %>
  </div>


  <div class="field">
    <p><%= f.label :password %> <i>(оставьте пустым, если не хотите менять)</i></p>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
    <% if @minimum_password_length %>
      <p><em><%= @minimum_password_length %> символов минимум</em></p>
    <% end %>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation, "Подтверждение пароля" %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :current_password, "Текущий пароль" %> <i>(нужен для сохранения изменений)</i></p>
    <p><%= f.password_field :current_password, autocomplete: "current-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit "Сохранить изменения" %>
  </div>
<% end %>

<h3>Удалить аккаунт</h3>
<p>Не хотите оставаться с нами? <%= button_to "Удалить аккаунт", registration_path(resource_name), data: { turbo_confirm: "Вы уверены?" }, method: :delete %></p>

<%= link_to "Назад", :back %>