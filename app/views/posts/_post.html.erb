<div class="post-card">
  <% if post.post_image.present? %>
    <%= image_tag post.post_image.url, class: "post-image" %>
  <% end %>
  <h2><%= post.title %></h2>
  <p><%= truncate(post.description, length: 120) %></p>
  <div class="post-meta">
    <%= post.created_at.strftime("%d.%m.%Y") %>
  </div>
</div>