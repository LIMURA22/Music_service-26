<%= link_to post, class: 'post-card' do %>
  <% if post.post_image.present? %>
    <%= image_tag post.post_image.url, class: "post-image" %>
  <% end %>
  
  <div class="post-author-info">
    <div class="post-author-avatar">
      
      <% if post.user&.avatar.present? %>
        <%= image_tag post.user.avatar.url %>
      <% else %>
        <%= post.user&.display_name&.first&.upcase || "M" %>
      <% end %>
    </div>
    <div>
      <div class="post-author-name"><%= post.user&.display_name || "Аноним" %></div>
      <div class="post-date"><%= post.created_at.strftime("%d.%m.%Y") %></div>
    </div>
  </div>

  <h2><%= post.title %></h2>
  <p><%= truncate(post.description, length: 120) %></p>
<% end %>