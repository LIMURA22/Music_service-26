<% if @post.pending? %>
  <div style="background: #fff3cd; color: #856404; padding: 12px 20px; border-radius: 8px; margin-bottom: 20px;">
    Этот пост на модерации. Его видишь только ты и админ.
  </div>
<% elsif @post.rejected? %>
  <div style="background: #f8d7da; color: #721c24; padding: 12px 20px; border-radius: 8px; margin-bottom: 20px;">
    Этот пост отклонён администратором.
  </div>
<% end %>

<article class="post-show">
  <div class="post-header" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; border-bottom: 1px solid #eee; padding-bottom: 16px;">
    
    <div class="post-author" style="display: flex; align-items: center; gap: 12px;">
      <% if @post.user&.avatar.present? %>
        <%= image_tag @post.user.avatar.url, style: "width: 48px; height: 48px; border-radius: 50%; object-fit: cover;" %>
      <% else %>
        <div style="width: 48px; height: 48px; border-radius: 50%; background: #e8b44a; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: bold; color: #1a1a1a;">
          <%= (@post.user&.display_name || "А").first.upcase %>
        </div>
      <% end %>
      <div>
        <div style="font-weight: 600; font-size: 16px;"><%= @post.user&.display_name || "Аноним" %></div>
        <div class="post-meta" style="font-size: 13px; color: #999;">Опубликовано <%= @post.created_at.strftime("%d.%m.%Y") %></div>
      </div>
    </div>

    <div class="tags-container">
      <% if @post.tags.any? %>
        <% @post.tags.each do |tag| %>
          <span class="tag-pill"><%= tag.name %></span>
        <% end %>
      <% end %>
    </div>
  </div>

  <h1 style="font-size: 36px; margin-bottom: 24px;"><%= @post.title %></h1>

  <% if @post.post_image.present? %>
    <%= image_tag @post.post_image.url, class: "post-image", style: "border-radius: 16px; width: 100%; margin-bottom: 24px; max-height: 500px; object-fit: cover;" %>
  <% end %>

  <p class="description" style="font-size: 18px; line-height: 1.8; margin-bottom: 24px;">
    <%= @post.description %>
  </p>

  <div class="post-actions">
    <div class="like-wrapper">
      <% if user_signed_in? %>
        <% like = @post.likes.find_by(user: current_user) %>
        <% if like %>
         
          <%= button_to post_like_path(@post, like), method: :delete, class: "like-btn liked", form_class: "inline-form" do %>
            <svg class="heart" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span class="like-count"><%= @post.likes.count %></span>
          <% end %>
        <% else %>
          
          <%= button_to post_likes_path(@post), method: :post, class: "like-btn", form_class: "inline-form" do %>
            <svg class="heart" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
              <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
            </svg>
            <span class="like-count"><%= @post.likes.count %></span>
          <% end %>
        <% end %>
      <% else %>
        
        <div class="like-btn" style="cursor: default;">
          <svg class="heart" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
          </svg>
          <span class="like-count"><%= @post.likes.count %></span>
        </div>
      <% end %>
    </div>

    <% if user_signed_in? && (current_user.admin? || @post.user_id == current_user.id) %>
      <%= link_to "Редактировать", edit_post_path(@post), class: "btn btn-secondary" %>
    <% end %>
    
    <% if user_signed_in? && current_user.admin? %>
      <%= button_to "Удалить", @post, method: :delete, class: "btn btn-danger", form_class: "inline-form", data: { turbo_confirm: "Точно удалить пост?" } %>
    <% end %>
    
    <%= link_to "Все посты", posts_path, class: "btn btn-primary" %>
  </div>
</article>

<section class="comments-section" style="margin-top: 40px;">
  <h2>Комментарии (<%= @post.comments.count %>)</h2>
  
  <div id="comments" style="margin-bottom: 32px;">
    <% if @post.comments.any? %>
      <%= render @post.comments %>
    <% else %>
      <p style="color: #999;">Пока нет комментариев. Будь первым!</p>
    <% end %>
  </div>

  <div class="comment-form">
    <% if user_signed_in? %>
      <h3 style="margin-bottom: 16px;">Добавить комментарий:</h3>
      <%= form_with(model: [@post, @comment]) do |form| %>
        <div class="form-group">
          <%= form.text_area :body, placeholder: "Напиши свой комментарий..."%>
        </div>
        <%= form.submit "Отправить", class: "btn btn-primary" %>
      <% end %>
    <% else %>
      <p>
        Чтобы оставить комментарий, <%= link_to "войдите", new_user_session_path %> или <%= link_to "зарегистрируйтесь", new_user_registration_path %>.
      </p>
    <% end %>
  </div>
</section>