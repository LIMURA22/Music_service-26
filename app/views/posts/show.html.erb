<% if @post.pending? %>
  <div style="background: #fff3cd; color: #856404; padding: 12px 20px; border-radius: 8px; margin-bottom: 20px;">
    Этот пост на модерации. Его видишь только ты и админ.
  </div>
<% elsif @post.rejected? %>
  <div style="background: #f8d7da; color: #721c24; padding: 12px 20px; border-radius: 8px; margin-bottom: 20px;">
    Этот пост отклонён администратором.
  </div>
<% end %>

<article class="post-show">
  <h1><%= @post.title %></h1>

    <div class="post-meta" style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
    <% if @post.user&.avatar.present? %>
      <%= image_tag @post.user.avatar.url, style: "width: 40px; height: 40px; border-radius: 50%; object-fit: cover;" %>
    <% else %>
      <div style="width: 40px; height: 40px; border-radius: 50%; background: #e8b44a; display: flex; align-items: center; justify-content: center; font-weight: bold; color: #1a1a1a;">
        <%= (@post.user&.display_name || "А").first.upcase %>
      </div>
    <% end %>
    <span>
      Автор: <strong><%= @post.user&.display_name || "Аноним" %></strong> · 
      Опубликовано <%= @post.created_at.strftime("%d.%m.%Y") %>
    </span>
  </div>

  <% if @post.post_image.present? %>
    <%= image_tag @post.post_image.url, class: "post-image" %>
  <% end %>

  <p class="description"><%= @post.description %></p>

  <div class="post-actions">
    <% if user_signed_in? && (current_user.admin? || @post.user_id == current_user.id) %>
      <%= link_to "Редактировать", edit_post_path(@post), class: "btn btn-secondary" %>
    <% end %>
    <% if user_signed_in? && current_user.admin? %>
      <%= button_to "Удалить", @post, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "Точно удалить пост?" } %>
    <% end %>
    <%= link_to "Все посты", posts_path, class: "btn btn-primary" %>
  </div>
</article>

<section class="comments-section">
  <h2>Комментарии (<%= @post.comments.count %>)</h2>

  <div id="comments">
    <% if @post.comments.any? %>
      <%= render @post.comments %>
    <% else %>
      <p style="color: #999;">Пока нет комментариев. Будь первым!</p>
    <% end %>
  </div>

  <div class="comment-form">
    <% if user_signed_in? %>
      <h3 style="margin-bottom: 16px;">Добавить комментарий:</h3>
      <%= form_with(model: [@post, @comment]) do |form| %>
        <div class="form-group">
          <%= form.text_area :body, placeholder: "Напиши свой комментарий..." %>
        </div>
        <%= form.submit "Отправить", class: "btn btn-primary" %>
      <% end %>
    <% else %>
      <p style="padding: 20px; background: #f7f7f7; border-radius: 8px; text-align: center;">
        Чтобы оставить комментарий, <%= link_to "войдите", new_user_session_path %> 
        или <%= link_to "зарегистрируйтесь", new_user_registration_path %>.
      </p>
    <% end %>
  </div>
</section>