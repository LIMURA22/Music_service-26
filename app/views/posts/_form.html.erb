<%= form_with(model: post) do |form| %>
  <% if post.errors.any? %>
    <div style="color: red; margin-bottom: 20px;">
      <h2><%= pluralize(post.errors.count, "ошибка") %>:</h2>
      <ul>
        <% post.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :title, "Заголовок" %>
    <%= form.text_field :title, placeholder: "Например: Как играть флажолет" %>
  </div>

  <div class="form-group">
    <%= form.label :description, "Описание" %>
    <%= form.text_area :description, placeholder: "Расскажи подробнее..." %>
  </div>

  <div class="form-group">
    <%= form.label :post_image, "Обложка" %>
    <%= form.file_field :post_image %>
  </div>

  <div class="form-group">
    <%= form.label :tag_ids, "Теги (можно выбрать несколько)" %>
    <%= form.collection_select :tag_ids, Tag.order(:name), :id, :name, 
          {}, 
          { multiple: true, size: 5, class: "form-select" } %>
    <small style="color: #999; display: block; margin-top: 5px;">
      Зажми Cmd (на Mac) или Ctrl (на Windows), чтобы выбрать несколько тегов.
    </small>
  </div>

  <%= form.submit "Сохранить", class: "btn btn-primary" %>
<% end %>