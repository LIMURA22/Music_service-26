<div class="container" style="padding: 32px 0;">
  <h1>Мои посты</h1>
  <p style="color: #666; margin-bottom: 32px;">Здесь все твои посты — на модерации, опубликованные и отклонённые.</p>

  <% if @posts.any? %>
    <% @posts.each do |post| %>
      <div class="post-card" style="margin-bottom: 16px;">
        <h3>
          <%= link_to post.title, post, style: "color: #1a1a1a; text-decoration: none;" %>
        </h3>
        <p><%= truncate(post.description, length: 150) %></p>
        <p class="post-meta">
          <%= post.created_at.strftime("%d.%m.%Y %H:%M") %> ·
          <% if post.pending? %>
            <span style="color: #856404;"> На модерации</span>
          <% elsif post.approved? %>
            <span style="color: #155724;"> Опубликован</span>
          <% else %>
            <span style="color: #721c24;"> Отклонён</span>
          <% end %>
        </p>
        <div style="display: flex; gap: 8px; margin-top: 12px;">
          <%= link_to "Редактировать", edit_post_path(post), class: "btn btn-secondary" %>
          <%= link_to "Открыть", post, class: "btn btn-primary" %>
        </div>
      </div>
    <% end %>
  <% else %>
    <p style="color: #999;">У тебя пока нет постов. <%= link_to "Предложить первый", new_post_path %>.</p>
  <% end %>
</div>